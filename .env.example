# =============================================================================
# Sentinel-X — configuration de la pile complète (copier en .env, jamais commité)
# `make init` relie aussi ce fichier à services/infrastructure/.env
# (utilisé par les scripts de l'infra).
# =============================================================================

# IP sur laquelle les ports sont publiés : 127.0.0.1 en dev, 192.168.40.1 sur le serveur
BIND_IP=127.0.0.1

# --- Base (services/database) --------------------------------------------------
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me

# --- Comptes MQTT (make users) --------------------------------------------------
# sentinel_iot = ESP8266 (mdp fourni par Baptiste)
MQTT_ESP_PASSWORD=change-me
MQTT_BACKEND_PASSWORD=change-me
MQTT_VISION_PASSWORD=change-me
MQTT_DETECTION_PASSWORD=change-me
# DEV uniquement : laisser vide en prod (le compte simulator n'est alors pas créé)
MQTT_SIMULATOR_PASSWORD=

# --- Backend API ------------------------------------------------------------------
NODE_ENV=production
FRONTEND_URL=https://dashboard.sentinel.lan
# Clé de l'API (REST + WebSocket), 32 caractères minimum. Générée par `make init`
# (ou `make backend-api-key`) si vide. Le dashboard l'envoie en « Authorization: Bearer <clé> ».
BACKEND_API_KEY=

# --- Service de détection ---------------------------------------------------------
# Toutes les variables : services/backend-iot-alerts/detection-service/.env.example
# auto = modèles Orange de detection-service/models/ s'il y en a, sinon règles
PREDICTOR=auto
WARMUP_SECONDS=120
LOG_LEVEL=INFO
DETECTION_API_PORT=8000

# --- IA vision (human-detection) ------------------------------------------------------
# device_id publié sur sentinelx/{device_id}/camera : celui de l'ESP de la même pièce
CAMERA_DEVICE_ID=esp01
# Flux MJPEG de la webcam USB (host/capture.py tourne sur l'hôte)
CAMERA_STREAM_URL=http://host.docker.internal:8088/stream
CAMERA_PREVIEW_PORT=8089
YOLO_MODEL=yolo11n.pt
YOLO_CONF=0.35
# Clé partagée backend-api <-> API des visages du détecteur, 32 caractères minimum.
# Générée par `make init` (ou `make vision-api-key`) si vide.
VISION_API_KEY=
# Similarité cosinus minimale pour reconnaître un visage autorisé (plus haut = plus strict)
FACE_MATCH_THRESHOLD=0.363

# --- Simulateur (profil sim) --------------------------------------------------------
SIM_DEVICE=esp01

# Compte admin initial du dashboard (créé au 1er démarrage si la table users est vide)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Grafana (supervision, lecture seule sur la base) ----------------------------------
# Port publié sur GRAFANA_BIND_IP (127.0.0.1 = accès local / tunnel SSH uniquement)
GRAFANA_BIND_IP=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://localhost:3000/
GRAFANA_ADMIN_USER=admin
# Compte PostgreSQL lecture seule créé/mis à jour par grafana-db-init à chaque `make up`
GRAFANA_DB_USER=grafana_reader
# Générés par `make init` (ou `make grafana-secrets`) si vides
GRAFANA_ADMIN_PASSWORD=
GRAFANA_DB_PASSWORD=
GRAFANA_SECRET_KEY=
