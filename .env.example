# =============================================================================
# Sentinel-X — configuration de la pile complète (copier en .env, jamais commité)
# `make init` relie aussi ce fichier à services/sentinel-x-g4/infra/.env
# (utilisé par les scripts de l'infra).
# =============================================================================

# IP sur laquelle les ports sont publiés : 127.0.0.1 en dev, 192.168.40.1 sur le serveur
BIND_IP=127.0.0.1

# --- Base (sentinel-db) ---------------------------------------------------------
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me

# --- Comptes MQTT (make users) --------------------------------------------------
# sentinel_iot = ESP8266 (mdp fourni par Baptiste)
MQTT_ESP_PASSWORD=change-me
MQTT_BACKEND_PASSWORD=change-me
MQTT_VISION_PASSWORD=change-me
MQTT_DETECTION_PASSWORD=change-me
# DEV uniquement : laisser vide en prod (le compte simulator n'est alors pas créé)
MQTT_SIMULATOR_PASSWORD=

# --- Backend API ------------------------------------------------------------------
NODE_ENV=production
FRONTEND_URL=https://dashboard.sentinel.lan

# --- Service de détection ---------------------------------------------------------
# Toutes les variables : services/backend-iot-alerts/detection-service/.env.example
INSTALL_ORANGE=false
PREDICTOR=rules
WARMUP_SECONDS=120
LOG_LEVEL=INFO
DETECTION_API_PORT=8000

# --- Simulateur (profil sim) --------------------------------------------------------
SIM_DEVICE=esp01
